PORT=8080

# Supabase PostgreSQL
# Use the Supabase pooled connection string for server deployments.
# Example:
# ASCEND_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
ASCEND_DB_URL=jdbc:postgresql://YOUR-SUPABASE-HOST:6543/postgres?sslmode=require
ASCEND_DB_USER=postgres.YOUR-PROJECT-REF
ASCEND_DB_PASSWORD=YOUR-SUPABASE-DATABASE-PASSWORD

# Frontend origins allowed to call this API. Keep /api out of this value.
ASCEND_CORS_ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app,https://*.vercel.app

# IA gratuita (Groq). Crie sua chave em https://console.groq.com/keys
# Copie este arquivo para `.env` (que fica fora do versionamento) ou defina
# estas variaveis no Render/hosting. NUNCA exponha a chave no Vite/app mobile.
ASCEND_AI_PROVIDER=groq
ASCEND_AI_BASE_URL=https://api.groq.com/openai/v1
ASCEND_AI_API_KEY=YOUR_GROQ_API_KEY
ASCEND_AI_MODEL=openai/gpt-oss-20b
ASCEND_AI_RESPONSE_MODE=chat-completions

# Alternativas de modelo gratuito no Groq (troque ASCEND_AI_MODEL):
#   llama-3.1-8b-instant        -> mais rapido e barato em cota
#   openai/gpt-oss-20b          -> bom equilibrio qualidade/custo
#   openai/gpt-oss-120b         -> mais capaz
#   meta-llama/llama-4-scout-17b-16e-instruct
# A disponibilidade depende da cota e da regiao da sua conta Groq.
