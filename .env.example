PORT=8080

# Supabase PostgreSQL
# Use the Supabase pooled connection string for server deployments.
# Example:
# ASCEND_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
ASCEND_DB_URL=jdbc:postgresql://YOUR-SUPABASE-HOST:6543/postgres?sslmode=require
ASCEND_DB_USER=postgres.YOUR-PROJECT-REF
ASCEND_DB_PASSWORD=YOUR-SUPABASE-DATABASE-PASSWORD

# Frontend origins allowed to call this API. Keep /api out of this value.
ASCEND_CORS_ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app,https://*.vercel.app

# AI provider. OPENAI_API_KEY is also supported directly by the app.
OPENAI_API_KEY=YOUR-OPENAI-API-KEY
ASCEND_AI_MODEL=gpt-4.1-mini
