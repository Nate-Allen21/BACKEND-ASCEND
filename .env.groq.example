# Backend only. Never put the API key into a VITE_ variable.
# Confirm the Groq organization is on the Free plan before enabling requests.
ASCEND_AI_PROVIDER=groq
ASCEND_AI_BASE_URL=https://api.groq.com/openai/v1
ASCEND_AI_MODEL=openai/gpt-oss-20b
ASCEND_AI_RESPONSE_MODE=chat-completions
ASCEND_AI_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
